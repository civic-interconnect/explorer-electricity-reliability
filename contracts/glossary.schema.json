{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civic-interconnect.github.io/explorer-electricity-reliability/contracts/glossary.schema.json",
  "title": "Glossary file",
  "description": "Validates glossary/concepts.json (language-neutral) or a glossary/<language>.json text file.",
  "oneOf": [
    { "$ref": "#/$defs/conceptsFile" },
    { "$ref": "#/$defs/textFile" }
  ],
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "conceptId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "source": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "concept": {
      "type": "object",
      "required": ["id", "kind", "sources", "reviewed"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/conceptId" },
        "kind": { "enum": ["metric", "variant", "method", "term"] },
        "unit": { "type": "string" },
        "formula": {
          "type": "object",
          "required": ["expression"],
          "additionalProperties": false,
          "properties": {
            "expression": { "type": "string", "minLength": 1 },
            "variables": { "type": "array", "items": { "type": "string" } }
          }
        },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "related": { "type": "array", "items": { "$ref": "#/$defs/conceptId" } },
        "reviewed": { "type": "boolean" }
      }
    },
    "conceptsFile": {
      "type": "object",
      "required": ["schemaVersion", "concepts"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/semver" },
        "concepts": { "type": "array", "items": { "$ref": "#/$defs/concept" } }
      }
    },
    "entry": {
      "type": "object",
      "required": ["label", "definition"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "variables": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "textFile": {
      "type": "object",
      "required": ["schemaVersion", "language", "entries"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/semver" },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$" },
        "entries": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/entry" }
        }
      }
    }
  }
}
